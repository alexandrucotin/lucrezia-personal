# Database Postgres (Neon). In produzione usa l'indirizzo "pooled" (-pooler).
DATABASE_URL=

# Stringa casuale lunga, per firmare i login del pannello: openssl rand -hex 32
PAYLOAD_SECRET=

# Cloudflare R2, per le foto. Senza queste le foto restano sul disco locale
# (va bene solo in sviluppo).
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Modulo contatti (gia' in uso)
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
